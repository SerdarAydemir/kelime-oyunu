# --- Python İçerik Motoru (Puzzle Generator) ---
# NOTE: `dir/*` (not `dir/`) so the `!` re-includes below can work — git never
# descends into a fully-ignored directory.
tools/puzzle_generator/data/raw/*
tools/puzzle_generator/data/processed/*
# Hand-curated / audit-accumulated label data is NOT derivable — keep in git
# (unlike the downloaded tdk_words/blacklist and the derived pool/clue files).
!tools/puzzle_generator/data/raw/sensitive_answers.txt
!tools/puzzle_generator/data/processed/approved_words.json
!tools/puzzle_generator/data/processed/rejected_words.json
tools/puzzle_generator/data/cache/
tools/puzzle_generator/reports/
tools/puzzle_generator/.venv/
tools/puzzle_generator/__pycache__/
tools/puzzle_generator/.pytest_cache/
tools/puzzle_generator/.mypy_cache/
tools/puzzle_generator/.ruff_cache/
*.pyc